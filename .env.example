# ─── Proteção do dashboard (opcional, mas recomendado) ───────────────
# Se definido, o dashboard pede senha antes de mostrar os dados.
DASHBOARD_PASSWORD=

# ─── Shopify ─────────────────────────────────────────────────────────
# Crie um app em: Admin da loja → Configurações → Apps e canais de vendas
# → Desenvolver apps → Criar app → permissão read_orders → Instalar.
SHOPIFY_STORE_DOMAIN=totvs-ibirapuera-viasolbrazil-dc.myshopify.com
SHOPIFY_ADMIN_TOKEN=

# ─── Mercado Livre ───────────────────────────────────────────────────
# Crie um app em https://developers.mercadolivre.com.br → Suas aplicações.
# Recomendado: client_id + client_secret + refresh_token (renova sozinho).
ML_CLIENT_ID=
ML_CLIENT_SECRET=
ML_REFRESH_TOKEN=
# Alternativa rápida (expira em 6h — só para testar):
ML_ACCESS_TOKEN=

# ─── TikTok Shop ─────────────────────────────────────────────────────
# Crie um app em https://partner.tiktokshop.com → Developer → My Apps,
# autorize a loja e copie as credenciais abaixo.
TIKTOK_APP_KEY=
TIKTOK_APP_SECRET=
TIKTOK_ACCESS_TOKEN=
TIKTOK_SHOP_CIPHER=

# ─── Meta Ads (gasto de anúncios × vendas Shopify) ───────────────────
# Token com permissão ads_read (usuário de sistema no Business Manager).
META_ACCESS_TOKEN=
# Conta de anúncios (padrão: Via Sol Brazil)
META_AD_ACCOUNT_ID=804350203009075
